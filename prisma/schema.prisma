generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  address       String
  city          String
  productName   String
  quantity      Int         @default(1)
  amount        Float
  status        OrderStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
